# mGBA TCP server (host running mGBA; use WSL2 gateway IP for Windows mGBA)
MGBA_HOST=127.0.0.1
MGBA_PORT=5000

# Directory where mGBA writes screenshot PNGs
# On WSL2 with Windows mGBA, use the /mnt/c/... path to the Windows temp dir
SCREENSHOT_DIR=data/screenshots

# SQLite knowledge base path
KB_PATH=data/knowledge/knowledge.db

# Observation text file written by the MCP server after each observe() call
# Used by pokemon-mcp-screenshot to read player state without a live mGBA connection
OBS_FILE=data/current_observation.txt
